{
  "name": "turborepo-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "turbo run check-types typecheck",
    "test": "turbo run test",
    "deploy": "turbo run deploy",
    "wire:fixture": "turbo run wire:fixture"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "eslint": "^9.27.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
