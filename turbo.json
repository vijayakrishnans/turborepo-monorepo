{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**", ".wrangler/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "wire:fixture": {
      "cache": false,
      "outputs": []
    },
    "deploy": {
      "dependsOn": ["build", "test", "check-types", "typecheck", "lint"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
